,"dataRepublicacao":null,"permiteExcluir":true,"permiteAlterarData":true,"ehAgendamento":false,"textoAgendamento":null,"exibirDataInicioVigencia":true,"permiteAgendamento":true}],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":144661,"idSegmento":2616255,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":16,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"II - tenham sido indicadas:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":144661,"idSegmento":2616256,"versaoSegmento":1,"idTipoSegmento":14,"idAssunto":1,"ordemSegmentoAto":17,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"a) pelo Comitê Gestor do Imposto sobre Bens e Serviços - IBS, a seu critério, especialmente com vistas a fomentar a integração dos sistemas da CBS e do IBS;","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":144661,"idSegmento":2616257,"versaoSegmento":1,"idTipoSegmento":14,"idAssunto":1,"ordemSegmentoAto":18,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"b) por entidades representativas do setor de tecnologia da informação, especialmente das fornecedoras de software; ou","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":144661,"idSegmento":2616258,"versaoSegmento":1,"idTipoSegmento":14,"idAssunto":1,"ordemSegmentoAto":19,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"c) por entidades representativas de segmentos econômicos ou portes empresariais, como confederações, associações setoriais e conselhos profissionais.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBina