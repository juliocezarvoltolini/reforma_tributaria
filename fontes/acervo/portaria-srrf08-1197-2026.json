{"idAto":149819,"epigrafe":{"tipoAto":{"idTipoAto":57,"siglaTipoAto":"Port.","nomeTipoAto":"Portaria","prioridadeTipoAto":25,"exibirTipoAto":1},"numeroAto":"1197","dataAto":"2026-03-09","orgaos":[{"idOrgao":309,"exibirOrgao":1,"siglaOrgao":"SRRF08","nomeOrgao":"Superintendência Regional da Receita Federal do Brasil 8ª Região Fiscal","prioridadeOrgao":325,"emDestaque":false,"posicaoPesquisa":null,"preferenciaSiglaComum":null}],"dataAtoPorExtenso":"9 de março de 2026"},"epigrafeCompleta":"Portaria SRRF08 nº 1197, de 9 de março de 2026","epigrafeSimplificada":"Portaria SRRF08 nº 1197, de 09/03/2026","epigrafesAnteriores":[],"epigrafeUrl":"Port. SRRF08 nº 1197/2026","dadosPublicacao":"Publicado(a) no DOU de 11/03/2026, seção 1, página 31","dataPublicacao":"2026-03-11","dataVigenciaInicio":"2026-03-11","exibirVisoes":"1111","visao":"vigente","integro":true,"vigente":true,"ehRepublicado":false,"idAtoRepublicador":null,"dataRepublicador":null,"ehVisaoExclusiva":false,"publicado":true,"internet":true,"ementas":[{"mapper":null,"idAto":149819,"idSegmento":2680790,"versaoSegmento":1,"idTipoSegmento":1,"idAssunto":1,"ordemSegmentoAto":1,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Institui o Programa de Proatividade do Atendimento - Aproxime, no âmbito da 8ª Região Fiscal.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null}],"outrosSegmentos":[{"mapper":null,"idAto":149819,"idSegmento":2680791,"versaoSegmento":1,"idTipoSegmento":999,"idAssunto":1,"ordemSegmentoAto":2,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"A SUPERINTENDENTE DA RECEITA FEDERAL DO BRASIL NA 8ª REGIÃO FISCAL, no uso das competências que lhe são conferidas pelos artigos 243, 336, 359 e 364 do Regimento Interno da Secretaria Especial da Receita Federal do Brasil (RFB), aprovado pela <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=111265\" rel=\"nofollow\">Portaria ME nº 284, de 27 de julho de 2020</a>, publicada no Diário Oficial da União (DOU), de 27 de julho de 2020, e em conformidade com a <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=112023\" rel=\"nofollow\">Portaria RFB nº 4.261, de 28 de agosto de 2020</a>, publicada no DOU de 31 de agosto de 2020, <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=148599\" rel=\"nofollow\">Portaria RFB nº 627, de 23 de dezembro de 2025</a>, publicada no DOU de 26 de dezembro de 2025, e a <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=133903\" rel=\"nofollow\">Portaria Suara nº 42, de 3 de outubro de 2023</a>, publicada no DOU de 6 de outubro de 2023, resolve:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680792,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":3,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 1º Fica instituído, no âmbito da 8ª Região Fiscal, o Programa de Proatividade do Atendimento - Aproxime em observância às diretrizes estabelecidas pela <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=148599\" rel=\"nofollow\">Portaria RFB nº 627, de 23 de dezembro de 2025</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680793,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":4,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 2º São elegíveis ao Programa Aproxime, na 8ª Região Fiscal, as pessoas jurídicas que se enquadrem nos critérios estabelecidos no art. 3º da <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=148599#2666242\" rel=\"nofollow\">Portaria RFB nº 627, de 2025</a>, especificamente:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680794,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":5,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"I - classificadas como contribuintes diferenciados;","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680795,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":6,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"II - classificadas pelo Programa Receita Sintonia na categoria \"A+\"; ou","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680796,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":7,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"III - que atendam a outros critérios de seleção estabelecidos pela Superintendência Regional por meio de Portaria desde que não classificadas como contribuintes especiais, nos termos da <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=142294\" rel=\"nofollow\">Portaria RFB nº 505, de 30 de dezembro de 2024</a>, ou norma que vier a substituí-la.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680797,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":8,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 1º A seleção da pessoa jurídica para participação do Aproxime será efetuada pela localização física de sua matriz.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680798,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":9,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 2º A SRRF08 poderá limitar o escopo de elegibilidade estabelecido nos incisos I e II do caput.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680799,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":10,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 3º Observado o disposto no inciso III, segundo o interesse da SRRF08, poderá o convite ser estendido a outras entidades, conforme a capacidade de atendimento da equipe do Aproxime.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680800,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":11,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 4º A seleção a que se refere o § 1º será comunicada à pessoa jurídica selecionada, que poderá optar pela adesão ao Programa.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680801,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":12,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 3º A adesão ao Aproxime será realizada mediante manifestação formal da pessoa jurídica selecionada, e seu deferimento ficará condicionado à prestação de informações em processo digital constituído para essa finalidade.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680802,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":13,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 1º Para fins de comunicação com a Secretaria Especial da Receita Federal do Brasil no âmbito do Aproxime, a pessoa jurídica a que se refere o caput deverá observar a obrigatoriedade de utilização do Domicílio Tributário Eletrônico - DTE, nos termos do que dispõe o parágrafo 5º, art. 59, da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm#art59§5\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>, com redação dada pela <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp227.htm\" rel=\"nofollow\">Lei Complementar nº 227, de 13 de janeiro de 2026</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680803,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":14,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 2º O atendimento por equipe do Aproxime somente será disponibilizado após o deferimento da adesão.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680804,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":15,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 3º A interlocução com a pessoa jurídica aderente deverá ser estabelecida mediante representantes devidamente cadastrados perante a SRRF08.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680805,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":16,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 4º As orientações fornecidas pelo Aproxime possuem caráter procedimental e não produzem os efeitos legais da consulta prevista no art. 46 do <a href=\"https://www.planalto.gov.br/ccivil_03/decreto/d70235cons.htm#art46\" rel=\"nofollow\">Decreto nº 70.235, de 6 de março de 1972</a>, e no art. 48 da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/l9430.htm#art48\" rel=\"nofollow\">Lei nº 9.430, de 27 de dezembro de 1996</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680806,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":17,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 5º Em observância ao disposto no art. 6º da <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=148599#2666265\" rel=\"nofollow\">Portaria RFB nº 627, de 2025</a>, as atividades do Aproxime serão exercidas por servidores que integram a Equipe de Atendimento Regional 1 - EATRE-1, instituída pela Portaria SRRF08 nº 121, de 07 de março de 2019, publicada no DOU nº 47, de 11 de março de 2019, Seção 2, ou à estrutura que vier a substituir a EATRE-1.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680807,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":18,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 6º A Equipe Regional Aproxime-SRRF08 será uma subequipe da EATRE-1, subordinada à Divisão Regional de Atendimento - DIATE08 ou estrutura que venha a substituí-la, com o objetivo de assegurar, no âmbito das competências da Secretaria Especial da Receita Federal do Brasil, a emissão regular da certidão de débitos relativos a créditos tributários federais e à dívida ativa da União.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680808,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":19,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§1º O monitoramento e a análise de dados realizados para fins de emissão da certidão a que se refere o caput, devem ser iniciados, no mínimo, 60 (sessenta) dias antes da data de vencimento da última certidão, a fim de assegurar a eficácia de sua renovação.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680809,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":20,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 2º A critério da equipe do Aproxime, a liberação da certidão pode ocorrer de ofício, com dispensa do requerimento previsto no art. 12 da <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=56753#1450773\" rel=\"nofollow\">Portaria Conjunta RFB/PFGN nº 1.751, de 2 de outubro de 2014</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680810,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":21,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 3º A pessoa jurídica será cientificada da renovação de ofício da certidão mediante a utilização de sistema de interação com o contribuinte.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680811,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":22,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 7º Caso seja constatada a necessidade de regularização ou suspensão de processos ou de débitos de competência de outras equipes da Secretaria Especial da Receita Federal do Brasil, a equipe do Aproxime deverá providenciar o encaminhamento à equipe competente, que terá prazo para resposta de até 30 (trinta) dias, contado da data de recebimento da demanda, não implicando prioridade de análise processual.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680812,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":23,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Parágrafo único O prazo previsto no caput deverá ser reduzido a 8 (oito) dias para fins de emissão tempestiva de certidão requerida pelo contribuinte no prazo previsto no art. 12, § 2º, da <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=56753#1450775\" rel=\"nofollow\">Portaria Conjunta RFB/PFGN nº 1.751, de 2 de outubro de 2014</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680813,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":24,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 8º Incumbe a equipe do Aproxime o acompanhamento das condições de permanência das pessoas jurídicas no Programa, cabendo a aplicação de exclusão nas seguintes hipóteses:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680814,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":25,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"I - por desenquadramento dos critérios de elegibilidade previstos no art. 2º que fundamentaram sua adesão;","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680815,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":26,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"II - por descumprimento reiterado de ações necessárias para a regularidade fiscal; ou","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680816,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":27,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"III - a pedido do contribuinte.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680817,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":28,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 1º A existência de medida cautelar fiscal em desfavor do contribuinte, quando verificada, também implica a exclusão da pessoa jurídica do Aproxime.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680818,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":29,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§2º A comunicação da exclusão do Aproxime será realizada com a utilização dos meios de comunicação homologados pela RFB, observada a obrigatoriedade de adesão ao DTE, prevista no §1º do artigo 3º, devendo ser expedida com antecedência mínima de 30 (trinta) dias da data da exclusão.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680819,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":30,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 3º Cabe interposição de recurso contra a exclusão, nos termos da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/l9784.htm\" rel=\"nofollow\">Lei nº 9.784, de 29 de janeiro de 1999</a>, que será apreciado no âmbito da SRRF08.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680820,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":31,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 9º Enquanto não sobrevenha a regulamentação da Coordenação-Geral de Atendimento - Cogea, prevista no art. 10 da <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=148599#2666284\" rel=\"nofollow\">Portaria RFB nº 627, de 23 de dezembro de 2025</a>, a Equipe Regional Aproxime-SRRF08 observará, no que couber, os fluxos procedimentais e canais de comunicação definidos pela DIATE08, desde que não colidentes com a norma superior.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680821,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":32,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 10 Esta Portaria entra em vigor na data de sua publicação no Diário Oficial da União.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":149819,"idSegmento":2680822,"versaoSegmento":1,"idTipoSegmento":4,"idAssunto":1,"ordemSegmentoAto":33,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":true,"textoIntegra":"MÁRCIA CECÍLIA MENG","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null}],"ancorasRetificacaoEpigrafe":[],"ancorasNoAto":[],"historico":[],"tiposSegmento":[{"idTipoSegmento":0,"siglaTipoSegmento":"global","nomeTipoSegmento":"Global","idEstiloSegmento":null,"estiloSegmento":{"idEstiloSegmento":19,"atributos":[]},"hierarquiaTipoSegmento":null,"apareceEmSumario":false,"desinenciaTipoSegmento":false},{"idTipoSegmento":1,"siglaTipoSegmento":"ementa","nomeTipoSegmento":"Ementa","idEstiloSegmento":null,"estiloSegmento":{"idEstiloSegmento":1,"atributos":[{"idEstiloSegmento":1,"idAtributoEstiloSegmento":28,"atributo":"font-size","valor":"10pt"},{"idEstiloSegmento":1,"idAtributoEstiloSegmento":29,"atributo":"padding","valor":"24pt 0 24pt 0"},{"idEstiloSegmento":1,"idAtributoEstiloSegmento":30,"atributo":"padding","valor":"24pt 0 24pt 0"}]},"hierarquiaTipoSegmento":null,"apareceEmSumario":false,"desinenciaTipoSegmento":false},{"idTipoSegmento":3,"siglaTipoSegmento":"artigo","nomeTipoSegmento":"Artigo","idEstiloSegmento":null,"estiloSegmento":{"idEstiloSegmento":3,"atributos":[{"idEstiloSegmento":3,"idAtributoEstiloSegmento":100,"atributo":"text-indent","valor":"63px"}]},"hierarquiaTipoSegmento":7,"apareceEmSumario":true,"desinenciaTipoSegmento":false},{"idTipoSegmento":4,"siglaTipoSegmento":"fecho","nomeTipoSegmento":"Fecho","idEstiloSegmento":null,"estiloSegmento":{"idEstiloSegmento":4,"atributos":[{"idEstiloSegmento":4,"idAtributoEstiloSegmento":89,"atributo":"text-align","valor":"center"},{"idEstiloS