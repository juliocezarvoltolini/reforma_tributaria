 III, do Regimento Interno da Secretaria Especial da Receita Federal do Brasil, aprovado pela <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=111265#2163550\" rel=\"nofollow\">Portaria ME nº 284, de 27 de julho de 2020</a>, e tendo em vista o disposto na <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>, na <a href=\"https://www.planalto.gov.br/ccivil_03/leis/l8935.htm\" rel=\"nofollow\">Lei nº 8.935, de 18 de novembro de 1994</a>, e no <a href=\"https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2022/decreto/d11208.htm\" rel=\"nofollow\">Decreto nº 11.208, de 26 de setembro de 2022</a>, resolve:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629153,"versaoSegmento":1,"idTipoSegmento":10,"idAssunto":1,"ordemSegmentoAto":3,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":true,"textoIntegra":"CAPÍTULO I \n<br>\n DISPOSIÇÃO PRELIMINAR","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629155,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":4,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 1º Esta Instrução Normativa dispõe sobre as obrigações atribuídas aos serviços notariais e de registro pela <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>, relativas:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629156,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":5,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"I - ao compartilhamento, com as administrações tributárias, de informações e documentos relacionados a operações com bens imóveis urbanos e rurais, por meio do Sistema Nacional de Gestão de Informações Territoriais - Sinter de que trata o art. 2º do <a href=\"https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2022/decreto/d11208.htm#art2\" rel=\"nofollow\">Decreto nº 11.208, de 26 de setembro de 2022</a>; e","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629157,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":6,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"II - à adoção do Cadastro Imobiliário Brasileiro - CIB de que trata o art. 4º do <a href=\"https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2022/decreto/d11208.htm#art4\" rel=\"nofollow\">Decreto nº 11.208, de 26 de setembro de 2022</a>, como identificador único de bens imóveis urbanos e rurais.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629158,"versaoSegmento":1,"idTipoSegmento":10,"idAssunto":1,"ordemSegmentoAto":7,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":true,"textoIntegra":"CAPÍTULO II \n<br>\n DO COMPARTILHAMENTO POR MEIO DO SINTER","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629160,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":8,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 2º Os serviços notariais e de registro deverão integrar-se ao Sinter para o compartilhamento de informações e documentos relativos:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629161,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":9,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"I - às operações com imóveis previstas no art. 255 da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm#art255\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>; e","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629162,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":10,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"II - aos bens imóveis registrados, para fins de apuração de seu valor de referência.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629163,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":11,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Parágrafo único. Considera-se valor de referência a estimativa de valor de mercado dos bens imóveis, apurada conforme previsto no art. 256 da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm#art256\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629164,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":12,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 3º O compartilhamento de que trata o art. 2º deverá ser realizado por meio de sistema eletrônico disponibilizado pela Secretaria Especial da Receita Federal do Brasil, integrado ao Sinter, imediatamente após a lavratura ou registro de ato relativo a imóvel pelos serviços notariais e de registro.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629165,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":13,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Parágrafo único. As informações deverão ser enviadas de forma estruturada, conforme especificações técnicas definidas pela Secretaria Especial da Receita Federal do Brasil.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629166,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":14,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 4º As informações e documentos a serem compartilhados pelos serviços notariais e de registro deverão observar as diretrizes técnicas definidas no âmbito do Sinter, com base na <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629167,"versaoSegmento":1,"idTipoSegmento":10,"idAssunto":1,"ordemSegmentoAto":15,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":true,"textoIntegra":"CAPÍTULO III \n<br>\n DA ADOÇÃO DO CIB","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629169,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":16,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 5º Os serviços notariais e registrais devem adotar o código de identificação único no CIB no prazo estabelecido no art. 266, caput, inciso I, alínea \"b\", da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm#art266\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>, o qual deverá constar de sistemas e de documentos lavrados ou registrados.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629170,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":17,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Parágrafo único. Para fins do disposto no caput, deverá ser observado o cronograma de implementação constante do plano de trabalho interinstitucional de que trata o Anexo Único, pactuado entre a Secretaria Especial da Receita Federal do Brasil, o Conselho Nacional de Justiça e os operadores dos registros públicos.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629171,"versaoSegmento":1,"idTipoSegmento":10,"idAssunto":1,"ordemSegmentoAto":18,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":true,"textoIntegra":"CAPÍTULO IV \n<br>\n DAS PENALIDADES","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629173,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":19,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 6º O descumprimento das obrigações previstas nesta Instrução Normativa será comunicado ao Conselho Nacional de Justiça, e sujeitará o infrator às penalidades previstas no art. 57 da <a href=\"https://www.planalto.gov.br/ccivil_03/mpv/2158-35.htm#art57..\" rel=\"nofollow\">Medida Provisória nº 2.158-35, de 24 de agosto de 2001</a>, sem prejuízo das sanções administrativas aplicáveis pelos órgãos de fiscalização notarial e registral.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629174,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":20,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 7º Na aplicação das penalidades a que se refere o art. 6º, deverá ser observado o contraditório e a ampla defesa.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629175,"versaoSegmento":1,"idTipoSegmento":10,"idAssunto":1,"ordemSegmentoAto":21,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":true,"textoIntegra":"CAPÍTULO V \n<br>\n DISPOSIÇÕES FINAIS","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"idSegmento":2629177,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":22,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 8º Nos termos do art. 268 da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm#art268\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>, a Secretaria Especial da Receita Federal do Brasil e o Comitê Gestor do Imposto sobre Bens e Serviços - IBS poderão estabelecer, mediante ato conjunto, obrigações acessórias necessárias ao cumprimento do disposto nesta Instrução Normativa.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145711,"i