5075,"versaoSegmento":1,"idTipoSegmento":14,"idAssunto":1,"ordemSegmentoAto":6,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"a) realizar diagnóstico sobre a situação cadastral e tecnológica;","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145382,"idSegmento":2625076,"versaoSegmento":1,"idTipoSegmento":14,"idAssunto":1,"ordemSegmentoAto":7,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"b) propor diretrizes técnicas e administrativas para a adoção e operacionalização do CIB; e","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145382,"idSegmento":2625077,"versaoSegmento":1,"idTipoSegmento":14,"idAssunto":1,"ordemSegmentoAto":8,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"c) sugerir a edição de normas e de orientações operacionais relativas à adoção e operacionalização do CIB;","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145382,"idSegmento":2625078,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":9,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"II - desenvolver modelos de integração entre os sistemas informatizados dos entes federativos e o Sistema Nacional de Gestão de Informações Territoriais - Sinter;","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":145382,"idSegmento":2625079,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":10,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"III - apoiar