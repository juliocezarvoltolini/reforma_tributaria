zenda.gov.br/sijut2consulta/link.action?idAto=111265\" rel=\"nofollow\">Portaria ME nº 284, de 27 de julho de 2020</a>, pulicada no Diário Oficial da União (DOU), de 27 de julho de 2020, e em conformidade com a <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=112023\" rel=\"nofollow\">Portaria RFB nº 4.261, de 28 de agosto de 2020</a>, publicada no DOU de 31 de agosto de 2020, <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=148599\" rel=\"nofollow\">Portaria RFB nº 627, de 23 de dezembro de 2025</a>, publicada no DOU de 26, de dezembro de 2025, e a <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=133903\" rel=\"nofollow\">Portaria Suara nº 42, de 3 de outubro de 2023</a>, publicada no DOU de 6 de outubro de 2023, resolve:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687159,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":3,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 1º Fica instituído, no âmbito da 3ª Região Fiscal, o Programa de Proatividade do Atendimento - Aproxime em observância às diretrizes estabelecidas pela <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=148599\" rel=\"nofollow\">Portaria RFB nº 627, de 23 de dezembro de 2025</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687160,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":4,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 2º São elegíveis ao Programa Aproxime, na 3ª Região Fiscal, as pessoas jurídicas que se enquadrem nos critérios estabelecidos no art. 3º da <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=148599#2666242\" rel=\"nofollow\">Portaria RFB nº 627, de 2025</a>, especificamente:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687161,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":5,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"I - Classificadas como contribuintes diferenciados;","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687162,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":6,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"II - Classificadas pelo Programa Receita Sintonia na categoria \"A+\"; ou","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687163,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":7,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"III - Atendam a outros critérios de seleção estabelecidos pela Superintendência Regional da Receita Federal na 3ª. Região Fiscal - SRRF03, por meio de Portaria, desde que não classificadas como contribuintes especiais, nos termos da <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=142294\" rel=\"nofollow\">Portaria RFB nº 505, de 30 de dezembro de 2024</a>, ou norma que vier a substitui-la.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687164,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":8,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 1º A seleção da pessoa jurídica para participação do Aproxime será efetuada pela localização física de sua matriz.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687165,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":9,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 2º A Superintendência poderá limitar o escopo de elegibilidade estabelecidos nos incisos I e II do caput.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687166,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":10,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 3º A seleção a que se refere o § 1º será comunicada à pessoa jurídica selecionada, que poderá optar pela adesão ao Programa.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687167,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":11,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 3º A adesão ao Aproxime será realizada mediante manifestação formal da pessoa jurídica selecionada, e seu deferimento ficará condicionado à prestação de informações em processo digital constituído para essa finalidade.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687168,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":12,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 1º O atendimento pela equipe do Aproxime somente será disponibilizado após o deferimento da adesão.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687169,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":13,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§2º Para fins de comunicação com a Secretaria Especial da Receita Federal do Brasil no âmbito do Aproxime, a pessoa jurídica a que se refere o caput deverá observar a obrigatoriedade de utilização do Domicílio Tributário Eletrônico - DTE, nos termos do que dispõe o parágrafo 5º, art. 59, da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm#art59§5\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>, com redação dada pela <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp227.htm\" rel=\"nofollow\">Lei Complementar nº 227, de 13 de janeiro de 2026</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687170,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":14,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 3º A interlocução com a pessoa jurídica aderente deverá ser estabelecida mediante representantes devidamente cadastrados perante a SRRF03.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687171,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":15,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 4º As orientações fornecidas pelo Aproxime possuem caráter procedimental e não produzem os efeitos legais da consulta prevista no art. 46 do <a href=\"https://www.planalto.gov.br/ccivil_03/decreto/d70235cons.htm#art46\" rel=\"nofollow\">Decreto nº 70.235/1972</a>, e no art. 48 da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/l9430.htm#art48\" rel=\"nofollow\">Lei nº 9.430 de 27 de dezembro de 1996</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687172,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":16,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 5º O programa Aproxime será executado pela Equipe Regional de Atendimento - 01 (EATRE1), subordinada à Divisão Regional de Atendimento - Diate03 ou estrutura que venha a substitui-la, com o objetivo de assegurar, no âmbito das competências da Secretaria Especial da Receita Federal do Brasil, a emissão regular da certidão de débitos relativos a créditos tributários federais e à dívida ativa da União.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687173,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":17,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§1º O monitoramento e a análise de dados realizados para fins de emissão da certidão a que se refere o caput, devem ser iniciados, no mínimo, 60 (sessenta) dias antes da data de vencimento da última certidão, a fim de assegurar a eficácia de sua renovação.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687174,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":18,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 2º A critério da equipe, a liberação da certidão pode ocorrer de ofício, com dispensa do requerimento previsto no art. 12 da <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=56753#1450773\" rel=\"nofollow\">Portaria Conjunta RFB/PFGN nº 1.751, de 2 de outubro de 2014</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687175,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":19,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 3º A pessoa jurídica será cientificada da renovação de ofício da certidão mediante a utilização de sistema de interação com o contribuinte.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687176,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":20,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 6º Caso seja constatada a necessidade de regularização ou suspensão de processos ou de débitos de competência de outras equipes da Secretaria Especial da Receita Federal do Brasil, a equipe do Aproxime deverá providenciar o encaminhamento à equipe competente, que terá prazo para resposta de até 30 (trinta) dias, contado da data de recebimento da demanda, não implicando prioridade de análise processual.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687177,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":21,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§1º O prazo previsto no caput deverá ser reduzido a 8 (oito) dias para fins de emissão tempestiva de certidão requerida pelo contribuinte no prazo previsto no art. 12, § 2º, da <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=56753#1450775\" rel=\"nofollow\">Portaria Conjunta RFB/PFGN nº 1.751, de 2 de outubro de 2014</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687178,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":22,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 2º O encaminhamento a que se refere o caput deverá ser registrado por meio do Sistema de Solicitações Corporativas - Solicorp, do e-Processo, do Receita Atende ou de sistema similar, conforme definição da Cogea, de forma a garantir o registro do tempo de resposta, sua rastreabilidade e auditabilidade.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687179,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":23,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 7º Incumbe à equipe do Aproxime o acompanhamento das condições de permanência das pessoas jurídicas no Programa, cabendo a aplicação de exclusão nas seguintes hipóteses:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687180,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":24,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"I - Por desenquadramento dos critérios de elegibilidade previstos no art. 2º que fundamentaram sua adesão;","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687181,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":25,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"II - Por descumprimento reiterado de ações necessárias para a regularidade fiscal; ou","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687182,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":26,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"III - A pedido do contribuinte.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687183,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":27,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§1º A comunicação da exclusão do Aproxime será realizada pela Caixa Postal do e-CAC, devendo ser expedida com antecedência mínima de 30 (trinta) dias da data da exclusão.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687184,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":28,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 2º Cabe interposição de recurso contra a exclusão, nos termos da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/l9784.htm\" rel=\"nofollow\">Lei nº 9.784/1999</a>, que será apreciado no âmbito da SRRF03.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":150232,"idSegmento":2687185,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":29,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 8 Esta Portaria entra em vigor na data de sua publicação 