{"idAto":146108,"epigrafe":{"tipoAto":{"idTipoAto":76,"siglaTipoAto":"NT","nomeTipoAto":"Nota Técnica","prioridadeTipoAto":35,"exibirTipoAto":1},"numeroAto":"256","dataAto":"2025-08-01","orgaos":[{"idOrgao":642,"exibirOrgao":1,"siglaOrgao":"Cocad","nomeOrgao":"Coordenação-Geral de Gestão de Cadastros e Benefícios Fiscais","prioridadeOrgao":119,"emDestaque":false,"posicaoPesquisa":null,"preferenciaSiglaComum":null}],"dataAtoPorExtenso":"1º de agosto de 2025"},"epigrafeCompleta":"Nota Técnica Cocad nº 256, de 1º de agosto de 2025","epigrafeSimplificada":"Nota Técnica Cocad nº 256, de 01/08/2025","epigrafesAnteriores":[],"epigrafeUrl":"NT Cocad nº 256/2025","dadosPublicacao":"Publicado(a) no Boletim de Serviço da RFB de 04/09/2025, seção 1, página 2","dataPublicacao":"2025-09-04","dataVigenciaInicio":"2025-09-04","exibirVisoes":"1111","visao":"vigente","integro":true,"vigente":true,"ehRepublicado":false,"idAtoRepublicador":null,"dataRepublicador":null,"ehVisaoExclusiva":false,"publicado":true,"internet":true,"ementas":[{"mapper":null,"idAto":146108,"idSegmento":2634020,"versaoSegmento":1,"idTipoSegmento":1,"idAssunto":1,"ordemSegmentoAto":1,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Assunto: Adoção do CIB e o compartilhamento de informações por meio do Sinter pelos serviços notariais e de registro – Edição de IN e dispensa de Análise de Impacto Regulatório (AIR). \n<br>\n Processo digital nº 10265.318780/2025-51","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null}],"outrosSegmentos":[{"mapper":null,"idAto":146108,"idSegmento":2634021,"versaoSegmento":1,"idTipoSegmento":6,"idAssunto":1,"ordemSegmentoAto":2,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"1. Esta Nota Técnica tem por objetivo fundamentar a dispensa da Análise de Impacto Regulatório (AIR) para a criação de Instrução Normativa que dispõe sobre a Adoção do CIB e o compartilhamento de informações por meio do Sinter pelos serviços notariais e de registro.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634022,"versaoSegmento":1,"idTipoSegmento":6,"idAssunto":1,"ordemSegmentoAto":3,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"2. O art. 5º da <a href=\"https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2019/lei/l13874.htm#art5\" rel=\"nofollow\">Lei nº 13.874, de 20 de setembro de 2019</a>, e o art. 6º da <a href=\"https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2019/lei/l13848.htm#art6\" rel=\"nofollow\">Lei nº 13.848, de 25 de junho de 2019</a>, estabelecem que as propostas de edição de atos normativos de interesse geral de agentes econômicos editadas por órgão ou entidade da administração pública federal, serão precedidas da realização de análise de impacto regulatório (AIR).","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634023,"versaoSegmento":1,"idTipoSegmento":6,"idAssunto":1,"ordemSegmentoAto":4,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"3. Por outro lado, de acordo com o regulamentado no <a href=\"https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2020/decreto/d10411.htm\" rel=\"nofollow\">Decreto nº 10.411, de 30 de junho de 2020</a>, a AIR poderá ser dispensada em algumas hipóteses, dentre elas:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634024,"versaoSegmento":1,"idTipoSegmento":999,"idAssunto":1,"ordemSegmentoAto":5,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"“Art. 4º A AIR poderá ser dispensada, desde que haja decisão fundamentada do órgão ou da entidade competente, nas hipóteses de:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634025,"versaoSegmento":1,"idTipoSegmento":999,"idAssunto":1,"ordemSegmentoAto":6,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"(...)","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634026,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":7,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"II - ato normativo destinado a disciplinar direitos ou obrigações definidos em norma hierarquicamente superior que não permita, técnica ou juridicamente, diferentes alternativas regulatórias;","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634027,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":8,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"III - ato normativo considerado de baixo impacto;","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634028,"versaoSegmento":1,"idTipoSegmento":999,"idAssunto":1,"ordemSegmentoAto":9,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"(...)”","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634029,"versaoSegmento":1,"idTipoSegmento":6,"idAssunto":1,"ordemSegmentoAto":10,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"4. A proposta de Instrução Normativa visa regulamentar obrigações já expressamente previstas na <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>, especialmente nos artigos 256, § 4º, e 266, inciso I, alínea 'b', que tratam, respectivamente, do compartilhamento de informações por meio do Sinter e da adoção do Cadastro Imobiliário Brasileiro (CIB) pelos serviços notariais e de registro. Dessa forma, a norma proposta apenas disciplina tecnicamente obrigações já definidas em norma hierarquicamente superior, sem margem para alternativas regulatórias.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634030,"versaoSegmento":1,"idTipoSegmento":999,"idAssunto":1,"ordemSegmentoAto":11,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Documento de 2 página(s) assinado digitalmente. Pode ser consultado pelo código de localização","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634031,"versaoSegmento":1,"idTipoSegmento":999,"idAssunto":1,"ordemSegmentoAto":12,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"APH5.C3BF.BR46P.YQ3X no endereço <a href=\"http://sadd.receita.fazenda.gov.br/sadd-internet/pages/validadocumento.xhtml\" rel=\"nofollow\">http://sadd.receita.fazenda.gov.br/sadd-internet/pages/validadocumento.xhtml</a> Consulte a página de autenticação no final deste documento.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634032,"versaoSegmento":1,"idTipoSegmento":999,"idAssunto":1,"ordemSegmentoAto":13,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Nota Técnica Cocad/RFB nº 256, de 01 de agosto de 2025","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634033,"versaoSegmento":1,"idTipoSegmento":6,"idAssunto":1,"ordemSegmentoAto":14,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"5. Além disso, a norma é voltada a um público específico e restrito (serviços notariais e de registro), não impondo custos relevantes nem alterando significativamente a rotina da maioria dos contribuintes, o que permite classificá-la como de baixo impacto.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634034,"versaoSegmento":1,"idTipoSegmento":6,"idAssunto":1,"ordemSegmentoAto":15,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"6. Assim, a proposta se enquadra nas hipóteses de dispensa de AIR previstas nos incisos II e III do art. 4º do <a href=\"https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2020/decreto/d10411.htm#art4\" rel=\"nofollow\">Decreto nº 10.411, de 30 de junho de 2020</a>.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634035,"versaoSegmento":1,"idTipoSegmento":6,"idAssunto":1,"ordemSegmentoAto":16,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"7. Isso posto, propõe-se o encaminhamento desta Nota ao Subsecretário de Arrecadação, Cadastros e Atendimento para subsidiar a análise da Exposição de Motivos para a publicação da Instrução Normativa que dispõe sobre a Adoção do CIB e o compartilhamento de informações por meio do Sinter pelos serviços notariais e de registro.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634036,"versaoSegmento":1,"idTipoSegmento":4,"idAssunto":1,"ordemSegmentoAto":17,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":true,"textoIntegra":"KATIA VANESSA GOMES GOURSAND \n<br>\n Analista Tributário da Receita Federal do Brasil \n<br>\n Chefe da Divisão de Cadastros de Imóveis","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634037,"versaoSegmento":1,"idTipoSegmento":999,"idAssunto":1,"ordemSegmentoAto":18,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"De acordo. Encaminhe-se à Coordenação-Geral de Gestão de Cadastros e Benefícios Fiscais.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634038,"versaoSegmento":1,"idTipoSegmento":4,"idAssunto":1,"ordemSegmentoAto":19,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":true,"textoIntegra":"RAFAEL NEVES CARVALHO \n<br>\n Auditor-Fiscal da Receita Federal do Brasil \n<br>\n Coordenador Operacional de Cadastros e Benefícios Fiscais (Cocat)","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634039,"versaoSegmento":1,"idTipoSegmento":999,"idAssunto":1,"ordemSegmentoAto":20,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Aprovo a Nota. Encaminhe-se à Subsecretaria de Arrecadação, Cadastros e Atendimento conforme proposto.","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":146108,"idSegmento":2634040,"vers